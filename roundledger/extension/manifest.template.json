{
  "manifest_version": 3,
  "name": "RoundLedger",
  "short_name": "RoundLedger",
  "version": "0.0.0",
  "description": "Round history, statistics and session tracking for supported crash games. Read-only: it never places bets.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open RoundLedger",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "scripting", "alarms"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
