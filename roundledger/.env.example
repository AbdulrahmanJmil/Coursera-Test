# RoundLedger server configuration. Copy to .env and fill in. Never commit .env.

# production | development
NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# Public https URL of this server (used for Secure cookies and HSTS).
PUBLIC_BASE_URL=https://api.example.com

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=1

# SQLite database file. Put it on persistent, backed-up storage.
DATABASE_PATH=/var/lib/roundledger/roundledger.db

# 32-byte key that encrypts provider API keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes stored API keys unreadable (re-enter them in the dashboard).
APP_ENCRYPTION_KEY=

# Comma-separated extension origins allowed by CORS (printed by `npm run build:extension`).
EXTENSION_ORIGINS=chrome-extension://aadijcahlcfcfdjgbcnapnnpdkgednoj

# Set LOG_REQUESTS=0 to silence per-request access logs.
LOG_REQUESTS=1
